# =======================
# DATABASE CONFIG
# =======================
DB_URL=jdbc:mysql://host.docker.internal:3306/ecommerce_example?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=ecommerce_example
DB_PASSWORD=your_db_password

# =======================
# CLOUDINARY CONFIG
# =======================
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# =======================
# GOOGLE OAUTH
# =======================
CLIENT_ID_GG=your_google_client_id
CLIENT_SECRET_GG=your_google_client_secret

# =======================
# FE + BE + FASTAPI
# =======================
BACKEND_URL=url_be_spring
FRONTEND_URL=https://datn-nextgen-suggest.site
FASTAPI_URL=url_fastapi

# =======================
# JWT CONFIG
# =======================
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# =======================
# ENCRYPTION
# =======================
KEY=example

# =======================
# MAPBOX TOKEN
# =======================
MAPBOX_TOKEN=your_mapbox_token

# =======================
# MAIL CONFIG
# =======================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# =======================
# REDIS CONFIG
# =======================
REDIS_HOST=example
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TIMEOUT=2000ms

# =======================
# RABBITMQ CONFIG
# =======================
RABBITMQ_HOST=example
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=example
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_EXCHANGE=product.exchange
RABBITMQ_QUEUE=product.indexing.queue
RABBITMQ_ROUTING_KEY=product.indexing
